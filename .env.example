# Copy to .env in the repository root and fill in. .env is ignored by git; never commit real keys.
# The $0 commands (oris demo, explain, score, replay, --profile b0) need no key at all.

# Required for live runs: Claude Haiku 4.5, the primary model (DESIGN.md §11.3)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: GPT-4o-mini fallback adapter (DESIGN.md §11.3). Uncomment only with a real key.
# OPENAI_API_KEY=sk-REPLACE_ME

# Optional: when set, /v1/* requires "Authorization: Bearer <token>" (DESIGN.md §11.4).
# Uncomment only with a non-empty value; leave it commented out for local use.
# ORIS_API_TOKEN=change-me
