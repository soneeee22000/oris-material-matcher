# Copy to .env and fill in. .env is ignored by git; never commit real keys.

# Required: Claude Haiku 4.5, the primary model (DESIGN.md §11.3)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: GPT-4o-mini fallback adapter and E-02(d) voter (DESIGN.md §11.3, §7.2)
OPENAI_API_KEY=sk-REPLACE_ME

# Optional: when set, /v1/* requires "Authorization: Bearer <token>" (DESIGN.md §11.4)
ORIS_API_TOKEN=
